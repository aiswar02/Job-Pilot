<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Profile | JobPilot</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include("partials/sidebar") %>

<div class="main-content">

    <%- include("partials/navbar") %>

    <h2>My Profile</h2>

    <form id="profileForm">

        <label>Name</label>
        <input type="text" id="name">

        <label>Email</label>
        <input type="email" id="email" disabled>

        <label>Qualification</label>
        <input type="text" id="qualification">

        <label>Graduation Year</label>
        <input type="number" id="graduationYear">

        <label>Experience (Years)</label>
        <input type="number" id="experienceYears">

        <label>Skills (comma separated)</label>
        <input type="text" id="skills"
               placeholder="HTML, CSS, JavaScript, Node.js">

        <label>Preferred Locations (comma separated)</label>
        <input type="text" id="locations"
               placeholder="Trivandrum, Kochi">

        <label>Work Modes</label>

        <select id="workModes" multiple>
            <option value="ONSITE">Onsite</option>
            <option value="HYBRID">Hybrid</option>
            <option value="REMOTE">Remote</option>
        </select>

        <label>Minimum Salary</label>
        <input type="number" id="minimumSalary">

        <button type="submit">Update Profile</button>

    </form>

    <p id="message"></p>

</div>

<script src="/js/script.js"></script>
<script src="/js/auth-guard.js"></script>
</body>
</html>