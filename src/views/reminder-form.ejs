<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reminder Form | JobPilot</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="sidebar">
    <h2 class="logo">Job<span>Pilot</span></h2>

    <a href="/dashboard">Dashboard</a>
    <a href="/applications">Applications</a>
    <a href="/reminders" class="active">Reminders</a>
    <a href="/job-analysis">Job Fit Checker</a>
    <a href="/resume">Resume</a>
    <a href="/profile">Profile</a>
    <a href="/settings">Settings</a>
</div>

<div class="main-content">

    <div class="topbar">
        <h2 id="reminderFormTitle">Add Reminder</h2>
        <a href="/reminders" class="btn">← Back to Reminders</a>
    </div>

    <div class="content-card">

        <form id="reminderForm">

            <label>Reminder Title</label>
            <input type="text" id="title" required
                   placeholder="Example: Follow up with HR">

            <label>Reminder Type</label>
            <select id="reminderType">
                <option value="INTERVIEW">Interview</option>
                <option value="FOLLOW_UP">Follow Up</option>
                <option value="OTHER">Other</option>
            </select>

            <label>Due Date and Time</label>
            <input type="datetime-local" id="dueDate" required>

            <label>Status</label>
            <select id="status">
                <option value="PENDING">Pending</option>
                <option value="COMPLETED">Completed</option>
                <option value="CANCELLED">Cancelled</option>
            </select>

            <label>Notes</label>
            <textarea id="notes" rows="4"
                      placeholder="Additional details..."></textarea>

            <button type="submit" class="btn" id="saveReminderBtn">
                Save Reminder
            </button>

        </form>

    </div>
</div>

<script src="/js/script.js"></script>
<script src="/js/auth-guard.js"></script>
</body>
</html>