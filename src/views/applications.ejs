<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Applications | JobPilot</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include("partials/sidebar") %>

<div class="main-content">

    <%- include("partials/navbar") %>

    <div class="topbar">
        <h2>Job Applications</h2>
        <a href="/applications/add" class="btn">+ Add Application</a>
    </div>

    <div class="content-card">

        <div class="search-container">
            <input type="text" id="searchApplication"
                   placeholder="Search company or job title...">

            <select id="filterStatus">
                <option value="">All Statuses</option>
                <option value="SAVED">Saved</option>
                <option value="APPLIED">Applied</option>
                <option value="ASSESSMENT">Assessment</option>
                <option value="INTERVIEW">Interview</option>
                <option value="OFFER">Offer</option>
                <option value="REJECTED">Rejected</option>
            </select>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Job Title</th>
                        <th>Status</th>
                        <th>Applied Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="applicationsTable">
                    <tr>
                        <td colspan="5">Loading applications...</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

</div>

<script src="/js/script.js"></script>
<script src="/js/auth-guard.js"></script>

<!-- Custom Modal -->
<div id="customModal" class="modal-overlay">
    <div class="modal-box">
        <h3 id="modalTitle">Confirmation</h3>

        <p id="modalMessage">Are you sure?</p>

        <div class="modal-buttons">
            <button id="modalCancel" class="modal-cancel">
                Cancel
            </button>

            <button id="modalConfirm" class="modal-confirm">
                Confirm
            </button>
        </div>
    </div>
</div>
</body>
</html>