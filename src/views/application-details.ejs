<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application Details | JobPilot</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include("partials/sidebar") %>

<div class="main-content">

    <%- include("partials/navbar") %>

    <div class="topbar">
        <h2>Application Details</h2>
        <a href="/applications" class="btn">Back to Applications</a>
    </div>

    <div class="content-card" id="applicationDetails">
        <p>Loading application details...</p>
    </div>

</div>

<script src="/js/script.js"></script>
<script src="/js/auth-guard.js"></script>

<!-- Custom Modal -->
<div id="customModal" class="modal-overlay">
    <div class="modal-box">
        <h3 id="modalTitle">Confirmation</h3>

        <p id="modalMessage">Are you sure?</p>

        <div class="modal-buttons">
            <button id="modalCancel" class="modal-cancel">
                Cancel
            </button>

            <button id="modalConfirm" class="modal-confirm">
                Confirm
            </button>
        </div>
    </div>
</div>

</body>
</html>